---
export const prerender = false;

import StatsContent from "~/components/StatsContent.astro";
import Layout from "~/layouts/Layout.astro";
import { getTopLanguages, getUsername } from "~/lib/github";
import { STATS_CACHE_TTL_SECONDS } from "~/lib/stats-cache";
import { getProfileStats, getUserData } from "~/server/github";
import {
  getContributionInsights,
  getLatestReleases,
} from "~/server/github-readme";
import type { Stat } from "~/types/github/stat";

const username = getUsername();

// The calendar, streaks and releases are extras: the page still renders
// without them if those queries fail.
async function settle<T>(promise: Promise<T>) {
  try {
    return { ok: true as const, value: await promise };
  } catch (error) {
    console.error(error);

    return { ok: false as const };
  }
}

const [{ user, fetchedAt }, profileStats, insightsResult, releasesResult] =
  await Promise.all([
    getUserData(username),
    getProfileStats(username),
    settle(getContributionInsights(username)),
    settle(getLatestReleases(username)),
  ]);

const insights = insightsResult.ok ? insightsResult.value : undefined;

const releases = releasesResult.ok
  ? releasesResult.value.slice(0, 8)
  : undefined;

const formatNumber = (value: number) => value.toLocaleString("en-GB");

const plural = (count: number, singular: string) =>
  `${formatNumber(count)} ${count === 1 ? singular : `${singular}s`}`;

const githubStats: Array<Stat> = [
  ...(insights
    ? [
        {
          key: "calendar",
          url: `https://github.com/${username}`,
          title: `Contributions ${insights.year}`,
          value: formatNumber(insights.thisYearTotal),
          secondaryValue: `${formatNumber(insights.allTimeTotal)} since ${insights.memberSince}`,
        },
      ]
    : []),
  {
    key: "contributions",
    url: `https://github.com/${username}`,
    title: "Commits",
    value: formatNumber(profileStats.totalCommits),
  },
  {
    key: "pullRequests",
    url: `https://github.com/pulls?q=is%3Apr+author%3A${username}`,
    title: "Pull requests",
    value: formatNumber(profileStats.totalPullRequests),
    secondaryValue: insights
      ? `${formatNumber(insights.mergedPullRequests)} merged`
      : undefined,
  },
  {
    key: "issues",
    url: `https://github.com/issues?q=is%3Aissue+author%3A${username}`,
    title: "Issues",
    value: formatNumber(profileStats.totalIssues),
  },
  {
    key: "repositories",
    url: `https://github.com/${username}?tab=repositories`,
    title: "Repositories",
    value: formatNumber(profileStats.publicRepositories),
  },
  {
    key: "stars",
    url: `https://github.com/${username}?tab=repositories`,
    title: "Stars",
    value: formatNumber(profileStats.totalStars),
  },
  {
    key: "followers",
    url: `https://github.com/${username}?tab=followers`,
    title: "Followers",
    value: formatNumber(profileStats.followers),
    secondaryValue: `(${formatNumber(user.following.totalCount)} following)`,
  },
  ...(insights
    ? [
        {
          key: "streak",
          url: `https://github.com/${username}`,
          title: "Streak",
          value: plural(insights.currentStreak, "day"),
          secondaryValue: `longest ${plural(insights.longestStreak, "day")}`,
        },
      ]
    : []),
];

const githubTopLanguages = getTopLanguages(user);

Astro.response.headers.set(
  "Cache-Control",
  `public, s-maxage=${STATS_CACHE_TTL_SECONDS}, stale-while-revalidate=${STATS_CACHE_TTL_SECONDS * 24}`,
);
---

<Layout
  title="Stats | Aidan Timson (Timmo)"
  description="GitHub stats for Aidan Timson (Timmo/timmo001): contributions, streaks, releases, and languages"
>
  <StatsContent
    {githubStats}
    {githubTopLanguages}
    {insights}
    {releases}
    {fetchedAt}
  />
</Layout>

<script>
  import { formatCacheTimes } from "~/scripts/format-cache-times";

  let formatTimer: ReturnType<typeof setTimeout>;

  function scheduleFormatCacheTimes(): void {
    clearTimeout(formatTimer);
    formatTimer = setTimeout(() => {
      void formatCacheTimes();
    }, 0);
  }

  scheduleFormatCacheTimes();

  document.addEventListener("astro:page-load", scheduleFormatCacheTimes);

  const main = document.querySelector("main");

  if (main) {
    new MutationObserver(scheduleFormatCacheTimes).observe(main, {
      childList: true,
      subtree: true,
    });
  }
</script>
