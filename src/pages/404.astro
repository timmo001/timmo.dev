---
import Layout from "~/layouts/Layout.astro";
---

<Layout title="Not Found | Aidan Timson (Timmo)">
  <header class="hero" data-hero role="banner">
    <div class="hero-inner">
      <div role="main">
        <h1 class="hero-title hero-reveal">Page not found</h1>
      </div>
      <gw-button
        href="/"
        size="large"
        class="hero-reveal hero-action"
        style="animation-delay: 0.1s"
      >
        Return Home
      </gw-button>
    </div>
  </header>
</Layout>
