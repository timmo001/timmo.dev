---
export const prerender = false;

import ActivityItem from "~/components/ActivityItem.astro";
import SubpageHeader from "~/components/SubpageHeader.astro";
import { contributions, projects } from "~/data/navigation";
import { getEnv } from "~/env";
import Layout from "~/layouts/Layout.astro";
import { STATS_CACHE_TTL_SECONDS } from "~/lib/stats-cache";
import { getCurrentActivity } from "~/server/github";

const catalogue = new Map(
  [...projects, ...contributions].map((item) => [
    item.githubHref ?? item.href,
    item,
  ]),
);
let activity: Awaited<ReturnType<typeof getCurrentActivity>> | undefined;

try {
  activity = await getCurrentActivity(getEnv().GITHUB_USERNAME);
} catch (error) {
  console.error(error);
}

Astro.response.headers.set(
  "Cache-Control",
  activity
    ? `public, s-maxage=${STATS_CACHE_TTL_SECONDS}, stale-while-revalidate=${STATS_CACHE_TTL_SECONDS * 24}`
    : "no-store",
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
const formatTimestamp = (date: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    dateStyle: "long",
    timeStyle: "short",
    timeZone: "UTC",
  }).format(date);
---

<Layout
  title="Current activity | Aidan Timson (Timmo)"
  description="Repositories Aidan Timson is currently working on, ranked from public GitHub activity over the last 30 days"
>
  <SubpageHeader title="Current activity" />
  <div class="flex w-full flex-col items-center px-4 py-16">
    <div class="container flex w-full flex-col gap-16 px-2">
      <section aria-label="Recent GitHub activity" class="flex flex-col gap-10">
        {
          activity && activity.items.length > 0 ? (
            <>
              <div class="stagger-grid grid items-stretch gap-x-6 gap-y-12 md:grid-cols-2 xl:grid-cols-3">
                {activity.items.map((item) => {
                  const repositoryName = item.nameWithOwner.split("/").at(-1);
                  const knownItem = catalogue.get(item.url);
                  return (
                    <ActivityItem
                      title={
                        knownItem?.title ?? repositoryName ?? item.nameWithOwner
                      }
                      nameWithOwner={item.nameWithOwner}
                      href={item.url}
                      description={
                        knownItem?.description ??
                        item.description ??
                        "Recent public work on GitHub."
                      }
                      commits={item.commits}
                      pullRequests={item.pullRequests}
                      reviews={item.reviews}
                      tags={knownItem?.tags}
                      stack={knownItem?.stack}
                    />
                  );
                })}
              </div>
              <p class="reveal px-6 text-sm text-white/45 md:px-12">
                Ranked from my public GitHub commits, pull requests, and
                reviews. Activity from {formatDate(activity.from)} to{" "}
                {formatDate(activity.to)}. Results are updated hourly and were
                last fetched {formatTimestamp(activity.fetchedAt)}.
              </p>
            </>
          ) : (
            <div class="reveal px-6 md:px-12">
              <p class="section-subtext">
                Current activity is unavailable right now. See my{" "}
                <a class="text-link" href="/projects">
                  projects and contributions
                </a>{" "}
                or browse my{" "}
                <a
                  class="text-link"
                  href="https://github.com/timmo001"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub profile
                </a>
                .
              </p>
            </div>
          )
        }
      </section>
    </div>
  </div>
</Layout>
