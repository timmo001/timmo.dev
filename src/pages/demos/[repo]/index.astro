---
// Rendered per request, so a new release's demo shows up without a rebuild.
export const prerender = false;

import { stringify } from "yaml";

import HaCardDemo from "~/components/HaCardDemo.astro";
import SectionBlock from "~/components/SectionBlock.astro";
import SubpageHeader from "~/components/SubpageHeader.astro";
import Layout from "~/layouts/Layout.astro";
import { getHaProjectDemos } from "~/lib/ha-projects";
import {
  PROJECTS_CACHE_TTL_SECONDS,
  PROJECTS_STALE_SECONDS,
} from "~/lib/stats-cache";

const entry = (await getHaProjectDemos()).find(
  ({ repoName }) => repoName === Astro.params.repo,
);

if (!entry) {
  return new Response(null, {
    status: 404,
    headers: { "Cache-Control": "no-store" },
  });
}

const { item, demo } = entry;

// The configuration of what the demo renders, without the mocked backend
const config = Object.fromEntries(
  Object.entries({
    dashboard: demo.dashboard,
    views: demo.views,
    sections: demo.sections,
    cards: demo.cards,
  }).filter(([, value]) =>
    Array.isArray(value) ? value.length > 0 : value !== undefined,
  ),
);

// Dashboards and views take the width of a dashboard, cards and sections the
// width of a column
const wide = demo.dashboard !== undefined || demo.views.length > 0;

Astro.response.headers.set(
  "Cache-Control",
  `public, s-maxage=${PROJECTS_CACHE_TTL_SECONDS}, stale-while-revalidate=${PROJECTS_STALE_SECONDS}`,
);
---

<Layout
  title={`${item.title} demo | Aidan Timson (Timmo)`}
  description={item.description}
>
  <SubpageHeader title={item.title} />
  <div class="page-body" role="main">
    <gw-page>
      <div class="page-sections">
        <section aria-label="About" class="reveal intro">
          <SectionBlock>
            {item.description}{" "}
            <a
              class="text-link"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub
            </a>
          </SectionBlock>
        </section>

        <section aria-label="Demo" class:list={["demo-stage", { wide }]}>
          <div
            class="demo-theme"
            data-demo-theme
            data-gw-theme="timmo"
            data-gw-mode="dark"
          >
            <gw-theme-picker
              layout="inline"
              modes="light dark"
              mode="dark"
              label="Demo colours"
            ></gw-theme-picker>
            <HaCardDemo demo={demo} />
          </div>
        </section>

        <section aria-label="Configuration" class="page-section intro">
          <p class="section-subtext">
            Live dashboard content running against a mocked Home Assistant in
            your browser, with this configuration:
          </p>
          <pre class="demo-config"><code>{stringify(config)}</code></pre>
        </section>
      </div>
    </gw-page>
  </div>
</Layout>

<script>
  import { initDemoTheme } from "~/scripts/demo-theme";

  initDemoTheme();

  document.addEventListener("astro:page-load", initDemoTheme);
</script>
