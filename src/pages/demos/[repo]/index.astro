---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { stringify } from "yaml";

import HaCardDemo from "~/components/HaCardDemo.astro";
import SectionBlock from "~/components/SectionBlock.astro";
import SubpageHeader from "~/components/SubpageHeader.astro";
import Layout from "~/layouts/Layout.astro";
import { getHaProjectDemos } from "~/lib/ha-projects";

export const getStaticPaths = (async () =>
  (await getHaProjectDemos()).map(({ repoName, item, demo }) => ({
    params: { repo: repoName },
    props: { item, demo },
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { item, demo } = Astro.props;
---

<Layout
  title={`${item.title} demo | Aidan Timson (Timmo)`}
  description={item.description}
>
  <SubpageHeader title={item.title} />
  <div class="page-body" role="main">
    <gw-page>
      <div class="page-sections">
        <section aria-label="About" class="reveal intro">
          <SectionBlock>
            {item.description}{" "}
            <a
              class="text-link"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub
            </a>
          </SectionBlock>
        </section>

        <section aria-label="Demo" class="demo-stage">
          <HaCardDemo demo={demo} />
        </section>

        <section aria-label="Configuration" class="page-section intro">
          <p class="section-subtext">
            A live card running against a mocked Home Assistant in your
            browser, with this configuration:
          </p>
          <pre class="demo-config"><code>{stringify(demo.cards.length === 1 ? demo.cards[0] : demo.cards)}</code></pre>
        </section>
      </div>
    </gw-page>
  </div>
</Layout>
