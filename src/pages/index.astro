---
import AnimatedText from "~/components/AnimatedText.astro";
import ContactLinks from "~/components/ContactLinks.astro";
import SectionBlock from "~/components/SectionBlock.astro";
import Layout from "~/layouts/Layout.astro";
---

<Layout>
  <header class="hero hero-tall" data-hero role="banner">
    <div class="hero-inner">
      <div class="hero-names">
        <h1 class="hero-title">
          <AnimatedText text="Aidan Timson" />
        </h1>
        <p class="hero-subtitle hero-reveal" style="animation-delay: 0.45s">
          <span>Timmo</span> / <span>@timmo001</span>
        </p>
      </div>
      <p class="hero-tagline">
        <AnimatedText
          text="Software Developer"
          delayPerLetter={0.015}
          startDelay={0.35}
        />
      </p>
    </div>
  </header>

  <div
    class="flex w-full flex-col items-center justify-start py-16"
    role="main"
  >
    <div
      class="stagger-grid content grid gap-x-4 gap-y-36 sm:grid-cols-1 md:grid-cols-2"
    >
      <h3 class="reveal section-heading">About Me</h3>
      <div class="reveal">
        <SectionBlock>
          My name is Aidan, but you might know me better as Timmo / @timmo001
          <br />
          <br />
          I am a full-stack software developer with a passion for creating and maintaining
          software. I'm an open source contributor and maintainer, one of which is
          for Home Assistant working on the frontend and around the project for the
          Open Home Foundation, working across desktop apps, home automation, and
          developer tooling.
          <br />
          <br />
          I'm a tinkerer with a strong interest in technology, automation, and software.
          I am always looking to improve my skills and learn new things, whether that
          be a new programming language, framework, or technology.
        </SectionBlock>
      </div>

      <h3 class="reveal section-heading">Current activity</h3>
      <div class="reveal">
        <SectionBlock>
          See what I have been working on recently on the{" "}
          <a class="text-link" href="/activity">current activity</a> page.
          The latest public commit, pull request, or review comes first.
        </SectionBlock>
      </div>

      <h3 class="reveal section-heading">Projects & contributions</h3>
      <div class="reveal">
        <SectionBlock>
          See my{" "}
          <a class="text-link" href="/projects"> projects & contributions </a>{
            " "
          }
          page for what I am building and contributing to, or browse my{" "}
          <a
            class="text-link"
            href="https://github.com/timmo001"
            target="_blank"
            aria-label="GitHub profile"
          >
            GitHub
          </a>{" "}
          profile.
        </SectionBlock>
      </div>

      <h3 class="reveal section-heading">Top Programming Languages</h3>
      <p class="reveal section-subtext mb-8">
        I have experience in a variety of programming languages. My top
        programming languages can be found on the{" "}
        <a class="text-link" href="/stats">stats</a> page.
      </p>
    </div>

    <div class="col-span-full mt-36 flex w-full flex-col items-center gap-8">
      <h3 class="reveal section-heading mb-8">Contact</h3>
      <div
        class="reveal flex w-full flex-row flex-wrap justify-center gap-x-24 gap-y-16"
      >
        <ContactLinks scale={2.5} />
      </div>
    </div>
  </div>
</Layout>
