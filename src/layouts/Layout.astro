---
import ContactLinks from "~/components/ContactLinks.astro";
import Footer from "~/components/Footer.astro";
import Navigation from "~/components/Navigation.astro";
import "../styles/global.css";
import "@timmo001/groundwork-tokens/themes.css";
import "~/styles/theme.generated.css";
import "~/styles/site.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Aidan Timson (Timmo)",
  description = "Personal website for Aidan Timson (Timmo)",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-gw-theme="timmo" data-gw-mode="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Aidan Timson (Timmo)" />
    <meta name="publisher" content="Aidan Timson" />
    <meta
      name="keywords"
      content="Aidan Timson, Timmo, Personal Website, Software Engineer, Software Developer, Full-Stack Developer"
    />
    <meta property="og:site_name" content="Aidan Timson (Timmo)" />
    <meta property="og:image" content="/og.png" />
    <meta property="og:url" content="https://timmo.dev" />
    <link rel="icon" href="/logo-letter-square-nobackground.png" />
  </head>
  <body>
    <gw-app-bar
      reveal-after="[data-hero]"
      overlay
      menu-below="1024"
      menu-label="Main navigation"
    >
      <a slot="brand" href="/">
        <img
          src="/logo-letter-square-nobackground.png"
          alt="Aidan Timson (Timmo)"
          width="40"
          height="40"
        />
      </a>
      <Navigation />
      <ContactLinks class="contact-links-menu" />
      <ContactLinks slot="actions" class="contact-links-bar" />
    </gw-app-bar>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import "@timmo001/groundwork-ui";
</script>
