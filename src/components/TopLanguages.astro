---
import { getUsername } from "~/lib/github";
import { type Language } from "~/types/github/language";

type Props = {
  languages: Array<Language>;
};

const { languages } = Astro.props;

const username = getUsername();
---

{
  languages.map((language) => (
    <gw-button
      class="reveal"
      variant="neutral"
      appearance="outlined"
      swatch={language.color}
    >
      <a
        href={`https://github.com/${username}?tab=repositories&language=${language.name.toLowerCase()}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {language.name}
      </a>
    </gw-button>
  ))
}
