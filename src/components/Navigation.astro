---
const navItems = [
  { href: "/", label: "About Me" },
  { href: "/activity", label: "Current activity" },
  { href: "/projects", label: "Projects & contributions" },
  { href: "/stats", label: "Stats" },
] as const;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

{
  navItems.map((item) => (
    <gw-button variant="neutral" appearance="plain">
      <a
        href={item.href}
        aria-current={item.href === path ? "page" : undefined}
      >
        {item.label}
      </a>
    </gw-button>
  ))
}
