---
import StatIcon from "~/components/StatIcon.astro";
import { type Stat } from "~/types/github/stat";

type Props = Stat;

const { key, url, title, value, secondaryValue } = Astro.props;
---

<gw-card class="reveal stat-card">
  <a
    slot="heading"
    class="stat-title"
    href={url}
    target="_blank"
    rel="noopener noreferrer"
  >
    {title}
  </a>
  <StatIcon statKey={key} />
  <span class="stat-value">{value}</span>
  <span class="stat-secondary muted">{secondaryValue ?? " "}</span>
</gw-card>
