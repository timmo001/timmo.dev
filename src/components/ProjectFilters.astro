---
import { getTagStyle } from "~/data/tag-styles";

type Props = {
  tags: Array<string>;
  stack: Array<string>;
};

const { tags, stack } = Astro.props;

const pickers = [
  { key: "tags", label: "Tags", placeholder: "All tags", items: tags },
  { key: "stack", label: "Stack", placeholder: "All stacks", items: stack },
] as const;
---

<div class="project-filters" data-project-filters>
  <gw-input
    class="project-search"
    type="search"
    label="Search"
    placeholder="Filter projects..."
    autocomplete="off"
    data-filter-search
  ></gw-input>
  {pickers.map((picker) => (
    <gw-select
      class="project-picker"
      multiple
      search="always"
      label={picker.label}
      placeholder={picker.placeholder}
      data-filter-picker={picker.key}
    >
      {picker.items.map((item) => (
        <option
          value={item.toLowerCase()}
          data-swatch={getTagStyle(item).backgroundColor}
        >
          {item}
        </option>
      ))}
    </gw-select>
  ))}
</div>

<gw-empty-state heading="No matching projects" hidden data-filter-empty>
  Try a shorter search, or fewer tags.
</gw-empty-state>
