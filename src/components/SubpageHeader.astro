---
import AnimatedText from "~/components/AnimatedText.astro";

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<header class="hero" data-hero role="banner">
  <div class="hero-inner">
    <h1 class="hero-title">
      <AnimatedText text={title} />
    </h1>
  </div>
</header>
