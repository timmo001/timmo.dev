---
import { type Language } from "~/types/github/language";

type Props = {
  languages: Array<Language>;
  limit?: number;
};

const { languages, limit = 9 } = Astro.props;

const shown = languages.slice(0, limit);

const total = shown.reduce((sum, language) => sum + language.size, 0);

const share = (language: Language) =>
  total === 0 ? 0 : (language.size / total) * 100;
---

<div class="reveal language-share">
  <div
    class="language-bar"
    role="img"
    aria-label={shown
      .map((language) => `${language.name} ${share(language).toFixed(1)}%`)
      .join(", ")}
  >
    {
      shown.map((language) => (
        <span
          style={`width: ${share(language)}%; background-color: ${language.color}`}
          title={`${language.name} ${share(language).toFixed(1)}%`}
        />
      ))
    }
  </div>
  <dl class="language-legend">
    {
      shown.map((language) => (
        <div>
          <span
            class="tag-dot"
            style={`background-color: ${language.color}`}
            aria-hidden="true"
          />
          <dt>{language.name}</dt>
          <dd class="muted">{share(language).toFixed(1)}%</dd>
        </div>
      ))
    }
  </dl>
</div>
