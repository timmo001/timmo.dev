---
import TagChip from "~/components/TagChip.astro";
import { sortStack } from "~/data/stack-sort";
import { sortTags } from "~/data/tag-sort";

type Props = {
  title: string;
  nameWithOwner: string;
  href: string;
  description: string;
  commits: number;
  pullRequests: number;
  reviews: number;
  tags?: Array<string>;
  stack?: Array<string>;
  hidden?: boolean;
};

const {
  title,
  nameWithOwner,
  href,
  description,
  commits,
  pullRequests,
  reviews,
  tags,
  stack,
  hidden = false,
} = Astro.props;

const metrics = [
  { count: commits, singular: "Commit", plural: "Commits" },
  { count: pullRequests, singular: "Pull request", plural: "Pull requests" },
  { count: reviews, singular: "Review", plural: "Reviews" },
];

const sortedTags = tags ? sortTags(tags) : undefined;

const sortedStack = stack ? sortStack(stack) : undefined;
---

<!-- Astro writes false as "false" on a custom element, so leave it off -->
<gw-card
  class="reveal activity-card"
  data-activity-item
  hidden={hidden ? true : undefined}
>
  <a
    slot="heading"
    class="card-title"
    href={href}
    target="_blank"
    rel="noopener noreferrer"
  >
    {title}
  </a>
  <p class="muted card-repo">{nameWithOwner}</p>
  {sortedTags && sortedTags.length > 0 && (
    <gw-row gap="s">
      {sortedTags.map((tag) => (
        <TagChip label={tag} />
      ))}
    </gw-row>
  )}

  <dl class="card-metrics">
    {metrics.map(({ count, singular, plural }) => (
      <div>
        <dt class="muted">{count === 1 ? singular : plural}</dt>
        <dd>{count.toLocaleString("en-GB")}</dd>
      </div>
    ))}
  </dl>

  <p class="card-text">{description}</p>
  {sortedStack && sortedStack.length > 0 && (
    <gw-row gap="s" class="card-stack">
      {sortedStack.map((item) => (
        <TagChip label={item} />
      ))}
    </gw-row>
  )}
</gw-card>
