---
import { format, parseISO } from "date-fns";

import { type ContributionDay } from "~/server/github-readme";

type Props = {
  days: Array<ContributionDay>;
  total: number;
};

const { days, total } = Astro.props;

const formatNumber = (value: number) => value.toLocaleString("en-GB");

const max = days.reduce((best, day) => Math.max(best, day.count), 0);

const busiest = days.reduce<ContributionDay | undefined>(
  (best, day) => (!best || day.count > best.count ? day : best),
  undefined,
);

const levelClasses = [
  "bg-white/5",
  "bg-indigo-950",
  "bg-indigo-800",
  "bg-indigo-500",
  "bg-indigo-300",
] as const;

function level(count: number): number {
  if (count <= 0 || max <= 0) {
    return 0;
  }

  return Math.min(4, Math.max(1, Math.ceil((count / max) * 4)));
}

const columns = Math.ceil(days.length / 7);

// Month labels sit above the first week that starts in a new month, skipping
// any that would overlap the previous label.
const months: Array<{ column: number; label: string }> = [];

let lastMonth = "";

let lastColumn = Number.NEGATIVE_INFINITY;

days.forEach((day, index) => {
  if (index % 7 !== 0) {
    return;
  }

  const column = index / 7;

  const month = day.date.slice(0, 7);

  if (month !== lastMonth) {
    if (lastMonth && column - lastColumn >= 3) {
      months.push({ column, label: format(parseISO(day.date), "MMM") });
      lastColumn = column;
    }

    lastMonth = month;
  }
});

const weekdayLabels = [
  { row: 2, label: "Mon" },
  { row: 4, label: "Wed" },
  { row: 6, label: "Fri" },
];
---

<div class="reveal flex w-full flex-col items-center gap-4">
  <div class="w-full overflow-x-auto pb-2">
    <div
      class="contribution-calendar mx-auto grid w-max gap-x-6"
      style={`--columns: ${columns}`}
    >
      <div
        class="col-start-2 grid h-4 text-xs text-white/45"
        style={`grid-template-columns: repeat(${columns}, 12px); column-gap: 3px`}
        aria-hidden="true"
      >
        {months.map(({ column, label }) => (
          <span
            style={`grid-column-start: ${column + 1}`}
            class="whitespace-nowrap"
          >
            {label}
          </span>
        ))}
      </div>
      <div
        class="col-start-1 row-start-2 grid text-xs text-white/45"
        style="grid-template-rows: repeat(7, 12px); row-gap: 3px"
        aria-hidden="true"
      >
        {weekdayLabels.map(({ row, label }) => (
          <span style={`grid-row-start: ${row}`} class="leading-3">
            {label}
          </span>
        ))}
      </div>
      <ul
        class="col-start-2 row-start-2 grid list-none"
        style={`grid-template-rows: repeat(7, 12px); grid-auto-flow: column; grid-auto-columns: 12px; gap: 3px`}
        aria-label={`${formatNumber(total)} contributions in the last year`}
      >
        {days.map((day) => {
          const label = `${formatNumber(day.count)} contributions on ${format(parseISO(day.date), "d MMMM yyyy")}`;

          return (
            <li
              class={`h-3 w-3 rounded-[3px] ${levelClasses[level(day.count)]}`}
              title={label}
              aria-label={label}
            />
          );
        })}
      </ul>
    </div>
  </div>
  <div class="flex w-full max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-2 text-sm text-white/45">
    <p>
      {formatNumber(total)} contributions in the last year
      {busiest && busiest.count > 0 && (
        <>
          , busiest on {format(parseISO(busiest.date), "d MMMM")} with{" "}
          {formatNumber(busiest.count)}
        </>
      )}
    </p>
    <p class="flex items-center gap-1.5" aria-hidden="true">
      <span>Less</span>
      {levelClasses.map((levelClass) => (
        <span class={`inline-block h-3 w-3 rounded-[3px] ${levelClass}`} />
      ))}
      <span>More</span>
    </p>
  </div>
</div>

<style>
  .contribution-calendar {
    grid-template-columns: auto auto;
    grid-template-rows: auto auto;
  }
</style>
