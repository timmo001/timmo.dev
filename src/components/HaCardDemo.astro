---
import { HA_EMBED_SCRIPT_URL, type HaProjectDemo } from "~/lib/ha-project-demo";

type Props = {
  demo: HaProjectDemo;
  // Load Home Assistant's embed and the card's script only when the demo
  // nears the viewport, for pages with several demos.
  lazy?: boolean;
};

const { demo, lazy = false } = Astro.props;

const providerData = {
  entities: demo.entities,
  areas: demo.areas,
  calendars: demo.calendars,
  energy: demo.energy,
};

// Keeps a "</script>" in the data from closing the script element.
const toScriptJson = (
  value: typeof providerData | HaProjectDemo["cards"][number],
) => JSON.stringify(value).replaceAll("<", "\\u003c");
---

<ha-embed-provider
  color-scheme="dark"
  class="ha-card-demo"
  data-embed-src={lazy ? HA_EMBED_SCRIPT_URL : undefined}
  data-card-src={lazy ? demo.script.path : undefined}
>
  <script
    is:inline
    type="application/json"
    set:html={toScriptJson(providerData)}
  />
  {demo.cards.map((card) => (
    <ha-embed-card>
      <script is:inline type="application/json" set:html={toScriptJson(card)} />
    </ha-embed-card>
  ))}
</ha-embed-provider>
{!lazy && (
  <>
    <script is:inline type="module" src={HA_EMBED_SCRIPT_URL} />
    <script is:inline type="module" src={demo.script.path} />
  </>
)}

<script>
  import { initLazyHaDemos } from "~/scripts/lazy-ha-demos";

  initLazyHaDemos();

  document.addEventListener("astro:page-load", initLazyHaDemos);
</script>
