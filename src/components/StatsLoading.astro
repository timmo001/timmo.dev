---
import SubpageHeader from "~/components/SubpageHeader.astro";
---

<SubpageHeader title="Loading..." />
<div
  class="page-body"
  role="main"
  aria-busy="true"
  aria-label="Loading stats"
>
  <div class="content page-sections stats">
    <gw-grid class="stat-grid">
      {Array.from({ length: 8 }, () => <gw-card loading lines={4} />)}
    </gw-grid>
    <gw-skeleton class="calendar-skeleton" />
  </div>
</div>
